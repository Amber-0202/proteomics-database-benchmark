[
  {
    "$match": {
      "geneSymbol": "Pcm1"
    }
  },
  {
    "$project": {
      "_id": 0,
      "datasetId": 1,
      "phosphopeptideId": 1,
      "geneSymbol": 1,
      "uniprotId": 1,
      "site": 1,
      "multiplicity": 1,
      "ptmLocalisation": 1,
      "insulinRegulationStatus": 1,
      "defectiveModelCount": 1,
      "emergentModelCount": 1,
      "defectiveModels": {
        "$map": {
          "input": {
            "$filter": {
              "input": {
                "$objectToArray": "$defects"
              },
              "as": "d",
              "cond": {
                "$eq": [
                  "$$d.v",
                  true
                ]
              }
            }
          },
          "as": "d",
          "in": "$$d.k"
        }
      },
      "emergentModels": {
        "$map": {
          "input": {
            "$filter": {
              "input": {
                "$objectToArray": "$emergent"
              },
              "as": "e",
              "cond": {
                "$ne": [
                  {
                    "$toUpper": {
                      "$toString": {
                        "$ifNull": [
                          "$$e.v",
                          "FALSE"
                        ]
                      }
                    }
                  },
                  "FALSE"
                ]
              }
            }
          },
          "as": "e",
          "in": {
            "model": "$$e.k",
            "direction": "$$e.v"
          }
        }
      },
      "linkedProteinAnalyteId": 1
    }
  },
  {
    "$sort": {
      "defectiveModelCount": -1,
      "emergentModelCount": -1,
      "site": 1,
      "multiplicity": 1
    }
  }
]
