[
  {
    "$match": {
      "insulinRegulationStatus": {
        "$in": [
          "defective",
          "emergent"
        ]
      }
    }
  },
  {
    "$group": {
      "_id": "$geneSymbol",
      "defectiveSites": {
        "$sum": {
          "$cond": [
            {
              "$eq": [
                "$insulinRegulationStatus",
                "defective"
              ]
            },
            1,
            0
          ]
        }
      },
      "emergentSites": {
        "$sum": {
          "$cond": [
            {
              "$eq": [
                "$insulinRegulationStatus",
                "emergent"
              ]
            },
            1,
            0
          ]
        }
      },
      "totalDysregulatedSites": {
        "$sum": 1
      }
    }
  },
  {
    "$sort": {
      "totalDysregulatedSites": -1,
      "_id": 1
    }
  },
  {
    "$limit": 20
  }
]
