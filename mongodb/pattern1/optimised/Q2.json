[
  {
    "$match": {
      "insulinRegulationStatus": "defective"
    }
  },
  {
    "$sort": {
      "phosphopeptideId": 1
    }
  },
  {
    "$limit": 5
  },
  {
    "$lookup": {
      "from": "samples",
      "localField": "linkedProteinAnalyteId",
      "foreignField": "totalProteomeMeasurements.proteinAnalyteId",
      "let": {
        "linkedProteinId": "$linkedProteinAnalyteId"
      },
      "pipeline": [
        {
          "$project": {
            "_id": 0,
            "sampleId": 1,
            "condition": 1,
            "totalProteomeMeasurements": {
              "$filter": {
                "input": "$totalProteomeMeasurements",
                "as": "m",
                "cond": {
                  "$eq": [
                    "$$m.proteinAnalyteId",
                    "$$linkedProteinId"
                  ]
                }
              }
            }
          }
        },
        {
          "$unwind": "$totalProteomeMeasurements"
        },
        {
          "$sort": {
            "sampleId": 1
          }
        },
        {
          "$limit": 10
        },
        {
          "$project": {
            "_id": 0,
            "sampleId": 1,
            "condition": {
              "conditionId": "$condition.conditionId",
              "model": "$condition.model",
              "insulinState": "$condition.insulinState"
            },
            "abundance": "$totalProteomeMeasurements.abundance"
          }
        }
      ],
      "as": "linkedProteinMeasurements"
    }
  },
  {
    "$project": {
      "_id": 0,
      "phosphopeptideId": 1,
      "geneSymbol": 1,
      "uniprotId": 1,
      "site": 1,
      "insulinRegulationStatus": 1,
      "defectiveModelCount": 1,
      "linkedProteinAnalyteId": 1,
      "linkedProteinMeasurements": 1
    }
  }
]
